# Pusat Data Dokumen Perencanaan - Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya

# Server
PORT=3001
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=pusat-data-bapperida-secret-ganti-ini-di-production

# Google Drive API (optional, untuk production)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Local Storage, Hot/Cold Archive & Backup (Server Lokal)
HOT_STORAGE_PATH=./storage/hot
ARCHIVE_STORAGE_PATH=./storage/archive
BACKUP_STORAGE_PATH=./storage/backup
CACHE_STORAGE_PATH=./storage/cache
LIFECYCLE_DAYS_THRESHOLD=30
LIFECYCLE_CRON_SCHEDULE="0 1 * * *"
BACKUP_CRON_SCHEDULE="30 1 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
