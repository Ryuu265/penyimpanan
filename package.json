  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },

  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "client": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "build:prod": "vite build && node server/index.js",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pinia": "^4.0.3",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
